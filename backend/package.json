{
  "name": "rjit-inventory-backend",
  "version": "1.0.0",
  "description": "Backend API for RJIT Inventory Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "test": "node --test tests/auth.test.js tests/inventory.test.js tests/issue.test.js tests/order.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:inventory": "node --test tests/inventory.test.js",
    "test:issue": "node --test tests/issue.test.js",
    "test:order": "node --test tests/order.test.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.14.0",
    "supertest": "^7.2.2"
  }
}
